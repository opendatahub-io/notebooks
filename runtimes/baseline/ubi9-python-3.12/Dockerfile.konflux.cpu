############################################################################################
# Phase 1 Dockerfile for runtimes/baseline/ubi9-python-3.12
#
# This baseline image intentionally uses a non-hermetic build path for phase 1:
# - RPMs are resolved online during the image build
# - Python packages are installed from requirements.${PYLOCK_FLAVOR}.txt via PyPI
#
# [PHASE 2 HERMETIC]
# The copied runtimes/datascience Dockerfile used cachi2-managed RPM/pip inputs.
# That logic is intentionally deferred for the later hermetic conversion of
# runtimes/baseline.
#
# Multi-stage layout:
#   cpu-base         -> installs OS packages + tools (oc client)
#   runtime-baseline -> final image (Elyra/Kale execution Python packages)
############################################################################################

#########################
# configuration args    #
#########################
ARG BASE_IMAGE

############################################################################################
# cpu-base: Runtime base image with OS packages, tools (oc)
#
# Phase 1 online runtime base.
############################################################################################
FROM ${BASE_IMAGE} AS cpu-base

WORKDIR /opt/app-root/bin

# OS Packages needs to be installed as root
USER 0

### BEGIN PyPI pip and uv index
ENV PIP_INDEX_URL=https://pypi.org/simple
ENV UV_INDEX_URL=https://pypi.org/simple
ENV UV_DEFAULT_INDEX=https://pypi.org/simple
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
if [ -f /opt/app-root/pip.conf ]; then
  sed -i 's|^index-url = .*|index-url = https://pypi.org/simple|' /opt/app-root/pip.conf
fi
if [ -f /opt/app-root/uv.toml ]; then
  sed -i 's|^index-url = .*|index-url = "https://pypi.org/simple"|' /opt/app-root/uv.toml
fi
EOF
### END PyPI pip and uv index

ARG RHEL_VERSION=9.8

RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

RUN subscription-manager release --set="${RHEL_VERSION}"

# Runtime installs need the OpenShift layered-product repo for openshift-clients.
RUN basearch="$(rpm --eval '%{_arch}')" && \
    dnf config-manager --set-enabled "rhocp-4.16-for-rhel-9-${basearch}-rpms"

# Install useful OS packages (runtime dependencies); oc from openshift-clients RPM.
# compat-openssl11 provides libcrypto.so.1.1 for openshift-clients on EL9 (check-payload FIPS scan).
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
dnf install -y tar perl mesa-libGL skopeo compat-openssl11 openshift-clients
dnf clean all
rm -rf /var/cache/dnf
EOF

# ppc64le/s390x: install openblas-threads (provides libopenblasp.so.0 at runtime for numpy/scipy)
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
if [[ $(uname -m) == "ppc64le" ]] || [[ $(uname -m) == "s390x" ]]; then
    dnf install -y openblas-threads
    dnf clean all
fi
EOF

USER 1001

#######################
# runtime-baseline    #
#######################
FROM cpu-base AS runtime-baseline

ARG BASELINE_SOURCE_CODE=runtimes/baseline/ubi9-python-3.12
ARG PYLOCK_FLAVOR

ARG LABEL_REGISTRY_PREFIX
ARG LABEL_COMPONENT
ARG RELEASE

LABEL name="${LABEL_REGISTRY_PREFIX}/${LABEL_COMPONENT}" \
      com.redhat.component="${LABEL_COMPONENT}" \
      io.k8s.display-name="${LABEL_COMPONENT}" \
      summary="Runtime baseline notebook image for ODH notebooks" \
      description="Runtime baseline notebook image with Python 3.12 based on UBI9 for ODH notebooks" \
      io.k8s.description="Runtime baseline notebook image with Python 3.12 based on UBI9 for ODH notebooks" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      version="${RELEASE}"

WORKDIR /opt/app-root/bin

USER 0

# Lean OS package set for Elyra/Kale execution (no DB-connector stack in phase 1).
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
PACKAGES=(jq git-lfs libsndfile libxcrypt-compat protobuf)
dnf install -y "${PACKAGES[@]}"
dnf clean all
rm -rf /var/cache/dnf
EOF

COPY --chown=1001:0 ${BASELINE_SOURCE_CODE}/utils ./utils/
COPY --chown=1001:0 prefetch-input/elyra-v4.3.1/elyra/kfp/bootstrapper.py /opt/app-root/bin/utils/bootstrapper.py
COPY --chown=1001:0 --chmod=0755 base-images/utils/ensure-openshift-site-packages.sh /usr/local/bin/ensure-openshift-site-packages.sh

# The raw RHEL Python base does not bootstrap uv the way the AIPCC notebook
# base does, so install it explicitly for the phase-1 online PyPI sync.
ARG UV_VERSION=0.12.5
RUN python3 -m pip install --no-cache-dir "uv==${UV_VERSION}"

ENV SHELL=/bin/bash
# Directory where uv pip install puts packages; PYTHONPATH must be a directory, not the python binary.
ENV PYTHONPATH=/opt/app-root/lib/python3.12/site-packages
ENV ELYRA_INSTALL_PACKAGES="false"

# Phase 1 Python install: hashed requirements from PyPI (non-hermetic).
COPY ${BASELINE_SOURCE_CODE}/requirements.${PYLOCK_FLAVOR}.txt ./requirements.txt
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
echo "Installing software and packages"
UV_NO_CACHE=true UV_LINK_MODE=copy \
uv pip install \
    --strict --no-deps --no-config --no-progress \
    --compile-bytecode --index-strategy=unsafe-best-match \
    --requirements=./requirements.txt

/usr/local/bin/ensure-openshift-site-packages.sh

# change ownership to default user (packages were installed as root)
chown -R 1001:0 /opt/app-root
EOF

USER 1001

# Fix permissions to support pip in OpenShift environments
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
chmod -R g+w /opt/app-root/lib/python3.12/site-packages
fix-permissions /opt/app-root -P
EOF

WORKDIR /opt/app-root/src
