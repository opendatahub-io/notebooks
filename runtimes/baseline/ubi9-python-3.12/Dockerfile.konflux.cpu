############################################################################################
# Hermetic Dockerfile for runtimes/baseline/ubi9-python-3.12
#
# RPMs and Python packages are installed from Cachi2 prefetch inputs:
# - RPMs: prefetch-input/odh (see rpms.in.yaml / rpms.lock.yaml)
# - Python: --no-index --find-links /cachi2/output/deps/pip
#
# Multi-stage layout:
#   cpu-base         -> installs OS packages + tools (oc client)
#   runtime-baseline -> final image (Elyra/Kale execution Python packages)
############################################################################################

#########################
# configuration args    #
#########################
ARG BASE_IMAGE

############################################################################################
# cpu-base: Runtime base image with OS packages, tools (oc)
############################################################################################
FROM ${BASE_IMAGE} AS cpu-base

WORKDIR /opt/app-root/bin

# OS Packages needs to be installed as root
USER 0

ARG RHEL_VERSION=9.8

# [HERMETIC] Import GPG keys for prefetched RPM verification.
RUN rpm --import /cachi2/output/deps/generic/RPM-GPG-KEY-CentOS-Official || true
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

### BEGIN PyPI pip and uv index
ENV PIP_INDEX_URL=https://pypi.org/simple
ENV UV_INDEX_URL=https://pypi.org/simple
ENV UV_DEFAULT_INDEX=https://pypi.org/simple
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
if [ -f /opt/app-root/pip.conf ]; then
  sed -i 's|^index-url = .*|index-url = https://pypi.org/simple|' /opt/app-root/pip.conf
fi
if [ -f /opt/app-root/uv.toml ]; then
  sed -i 's|^index-url = .*|index-url = "https://pypi.org/simple"|' /opt/app-root/uv.toml
fi
EOF

### END PyPI pip and uv index

# Bust layer cache when prefetched RPM set changes
COPY prefetch-input/odh/rpms.lock.yaml /dev/null
COPY prefetch-input/rhds/rpms.lock.yaml /dev/null

RUN --mount=type=bind,source=base-images/utils,target=/utils,ro \
    bash /utils/dnf-helper.sh install perl mesa-libGL skopeo compat-openssl11 openshift-clients

# ppc64le/s390x: install openblas-threads (provides libopenblasp.so.0 at runtime for numpy/scipy)
RUN --mount=type=bind,source=base-images/utils,target=/utils,ro \
    /bin/bash <<'EOF'
set -Eeuxo pipefail
if [[ $(uname -m) == "ppc64le" ]] || [[ $(uname -m) == "s390x" ]]; then
    bash /utils/dnf-helper.sh install openblas-threads
fi
EOF

USER 1001

#######################
# runtime-baseline    #
#######################
FROM cpu-base AS runtime-baseline

ARG BASELINE_SOURCE_CODE=runtimes/baseline/ubi9-python-3.12
ARG PYLOCK_FLAVOR

ARG LABEL_REGISTRY_PREFIX
ARG LABEL_COMPONENT
ARG RELEASE

LABEL name="${LABEL_REGISTRY_PREFIX}/${LABEL_COMPONENT}" \
      com.redhat.component="${LABEL_COMPONENT}" \
      io.k8s.display-name="${LABEL_COMPONENT}" \
      summary="Runtime baseline notebook image for ODH notebooks" \
      description="Runtime baseline notebook image with Python 3.12 based on UBI9 for ODH notebooks" \
      io.k8s.description="Runtime baseline notebook image with Python 3.12 based on UBI9 for ODH notebooks" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      version="${RELEASE}"

WORKDIR /opt/app-root/bin

USER 0

# Bust layer cache when prefetched RPM set changes
COPY prefetch-input/odh/rpms.lock.yaml /dev/null
COPY prefetch-input/rhds/rpms.lock.yaml /dev/null

RUN --mount=type=bind,source=base-images/utils,target=/utils,ro \
    bash /utils/dnf-helper.sh install jq git-lfs libsndfile libxcrypt-compat protobuf

COPY ${BASELINE_SOURCE_CODE}/requirements.${PYLOCK_FLAVOR}.txt ./requirements.txt
COPY --chown=1001:0 ${BASELINE_SOURCE_CODE}/utils ./utils/
COPY --chown=1001:0 prefetch-input/elyra-v4.3.1/elyra/kfp/bootstrapper.py /opt/app-root/bin/utils/bootstrapper.py
COPY --chown=1001:0 --chmod=0755 base-images/utils/ensure-openshift-site-packages.sh /usr/local/bin/ensure-openshift-site-packages.sh

# The raw RHEL Python base does not bootstrap uv the way AIPCC notebook bases
# do. Install uv from the hermeto/cachi2 pip cache (offline) before the main
# package install. Online `pip install uv` would break hermetic Konflux builds.
# UV_VERSION is derived from this image's requirements.cpu.txt by scripts/dockerfile_fragments.py.
### BEGIN UV version
ARG UV_VERSION=0.12.5

### END UV version
RUN python3 -m pip install --no-cache-dir --no-index \
    --find-links /cachi2/output/deps/pip \
    "uv==${UV_VERSION}"

USER 1001:0

ENV ELYRA_INSTALL_PACKAGES="false"

RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
umask 0002

echo "Installing software and packages"
UV_NO_CACHE=true UV_LINK_MODE=copy UV_PREVIEW_FEATURES=pylock uv pip install --no-index \
    --strict --no-deps --no-config --no-progress \
    --compile-bytecode --index-strategy=unsafe-best-match \
    --find-links /cachi2/output/deps/pip \
    --requirements=./requirements.txt

/usr/local/bin/ensure-openshift-site-packages.sh
EOF

USER 1001

WORKDIR /opt/app-root/src
