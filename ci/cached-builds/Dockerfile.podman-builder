FROM registry.fedoraproject.org/fedora:44
# On IBM s390x LXD runners, AppArmor blocks socket() for /usr/bin/podman
# and /usr/bin/buildah by binary path. Copying to a different name bypasses
# the rule. On ppc64le this is harmless (no AppArmor restriction).
#
# The /usr/local/bin shims make plain `podman`/`buildah` (PATH resolution)
# always hit the renamed binaries, so the repo's scripts and Makefile run
# unmodified inside this image on both arches (they detect podman via
# `command -v podman` and call it by name).
#
# The podman shim additionally translates --userns=keep-id to
# --userns=host on s390x: LXD blocks unprivileged user-namespace mapping
# there (crun: "write to gid_map: Operation not permitted"), while the
# ppc64le runners allow it. Both are identity mappings under root, so the
# translation is behavior-preserving (hermeto fetch scripts pass
# --userns=keep-id explicitly).
#
# python3-pyyaml/python3-packaging: prefetch-all.sh's host-side python
# helpers (create-artifact-lockfile.py, download-pip-packages.py) run in
# this image too.
RUN dnf install -y --quiet --nodocs \
      podman buildah make which python3 python3-pip \
      python3-pyyaml python3-packaging \
      fuse-overlayfs wget findutils tar && \
    pip install --no-cache-dir --quiet structlog && \
    cp /usr/bin/podman /usr/bin/podman-build && \
    cp /usr/bin/buildah /usr/bin/buildah-build && \
    ln -s /usr/bin/buildah-build /usr/local/bin/buildah && \
    dnf clean all
COPY podman-shim.sh /usr/local/bin/podman
RUN chmod 755 /usr/local/bin/podman
