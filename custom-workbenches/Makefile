# Build/push/validate for generated custom workbench folders (RHAIENG-7526 / RHAIENG-7241).
#
# Layout:
#   custom-workbenches/src/          ← template + collections
#   custom-workbenches/<my-image>/   ← generated by ./interactive-image-builder.sh
#
# Usage:
#   # 1) entitlements once — docs/subscribed-builds.md / README § Recommended workflow
#   ./interactive-image-builder.sh
#   make build RECIPE=my-trustyai PUSH_IMAGES=no
#   make validate RECIPE=my-trustyai
#   make push  RECIPE=my-trustyai

SHELL := bash
.ONESHELL:
.SHELLFLAGS := -Eeux -o pipefail -c
.DEFAULT_GOAL := help

ROOT_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

RECIPE ?=
PLATFORM ?=
CONTAINER_ENGINE ?= $(shell command -v podman >/dev/null && echo podman || echo docker)
PUSH_IMAGES ?= yes
# Extra podman/docker build flags, e.g. BUILD_ARGS='--build-arg INSTALL_OS_PACKAGES=false'
BUILD_ARGS ?=

RESERVED := src

ifeq ($(CONTAINER_ENGINE),podman)
CONTAINER_BUILD_SECURITY_ARGS ?= --security-opt label=disable
else
CONTAINER_BUILD_SECURITY_ARGS ?=
endif

.PHONY: help build push list collections validate

help:
	@echo "Custom workbenches (RHAIENG-7526) + package collections (RHAIENG-7241 §3)"
	@echo ""
	@echo "  Workflow: entitlements (docs/subscribed-builds.md) → ./interactive-image-builder.sh → make build"
	@echo ""
	@echo "  make collections"
	@echo "  make list"
	@echo "  make build    RECIPE=<folder> [PLATFORM=…] [PUSH_IMAGES=no]"
	@echo "  make push     RECIPE=<folder>"
	@echo "  make validate RECIPE=<folder>   # run collection import checks in the image"
	@echo ""
	@echo "Generate a sibling folder from src/:"
	@echo "  ./interactive-image-builder.sh"
	@echo ""
	@echo "AIPCC/RHEL: set up entitlement/ + consumer/ and mounts.conf before build"
	@echo "(see README.md § Recommended workflow). Escape hatch:"
	@echo "  BUILD_ARGS='--build-arg INSTALL_OS_PACKAGES=false'"

list:
	@found=0; \
	for d in "$(ROOT_DIR)"*/; do \
		name=$$(basename "$$d"); \
		case "$${name}" in src) continue ;; esac; \
		if [ -f "$${d}Containerfile" ]; then echo "$${name}"; found=1; fi; \
	done; \
	if [ "$${found}" = 0 ]; then echo "(no generated images yet — run ./interactive-image-builder.sh)"; fi

collections:
	@echo "Available use-case package collections (src/collections/):"
	@echo ""
	@for f in "$(ROOT_DIR)src/collections"/*/collection.toml; do \
		[ -f "$$f" ] || continue; \
		id=$$(basename "$$(dirname "$$f")"); \
		name=$$(python3 -c "import tomllib,pathlib; print(tomllib.loads(pathlib.Path('$$f').read_text())['collection']['name'])"); \
		desc=$$(python3 -c "import tomllib,pathlib; print(tomllib.loads(pathlib.Path('$$f').read_text())['collection'].get('description',''))"); \
		printf '  %-16s %s\n' "$$id" "$$name"; \
		printf '  %-16s %s\n' "" "$$desc"; \
		echo ""; \
	done
	@echo "Select via the wizard stack menu, or see src/collections/README.md"

define load_recipe_conf
	$(if $(RECIPE),,$(error Set RECIPE=<folder next to src/>, e.g. RECIPE=my-trustyai))
	$(if $(filter $(RECIPE),$(RESERVED)),$(error RECIPE=$(RECIPE) is reserved (template/tooling)))
	$(eval RECIPE_DIR := $(ROOT_DIR)$(RECIPE))
	$(if $(wildcard $(RECIPE_DIR)/Containerfile),,$(error No image at $(RECIPE_DIR) — run ./interactive-image-builder.sh))
	$(eval CONF := $(RECIPE_DIR)/build-args/default.conf)
	$(if $(wildcard $(CONF)),,$(error Missing $(CONF)))
	$(eval IMAGE_REF := $(shell awk -F= '/^IMAGE_REF=/{print $$2; exit}' $(CONF)))
	$(eval CONF_PLATFORM := $(shell awk -F= '/^PLATFORM=/{print $$2; exit}' $(CONF)))
	$(eval BUILD_PLATFORM := $(if $(PLATFORM),$(PLATFORM),$(CONF_PLATFORM)))
	$(if $(IMAGE_REF),,$(error IMAGE_REF missing in $(CONF)))
	$(if $(BUILD_PLATFORM),,$(error PLATFORM missing; set PLATFORM= or fix $(CONF)))
endef

build:
	$(call load_recipe_conf)
	@echo "# Syncing Containerfile + repos/ from src/ into $(RECIPE)/"
	cp "$(ROOT_DIR)src/Containerfile" "$(RECIPE_DIR)/Containerfile"
	mkdir -p "$(RECIPE_DIR)/repos"
	cp "$(ROOT_DIR)src/repos/openshift-clients.repo" "$(RECIPE_DIR)/repos/openshift-clients.repo"
	@echo "# Building $(IMAGE_REF) for $(BUILD_PLATFORM) from $(RECIPE_DIR)"
	$(CONTAINER_ENGINE) build \
		$(CONTAINER_BUILD_SECURITY_ARGS) \
		--platform=$(BUILD_PLATFORM) \
		--build-arg-file=$(CONF) \
		$(BUILD_ARGS) \
		--tag $(IMAGE_REF) \
		--file $(RECIPE_DIR)/Containerfile \
		$(RECIPE_DIR)
	@echo "# Built $(IMAGE_REF)"
	@$(if $(filter yes,$(PUSH_IMAGES)),$(MAKE) push RECIPE=$(RECIPE),echo "# Skipping push (PUSH_IMAGES=$(PUSH_IMAGES))")

push:
	$(call load_recipe_conf)
	@echo "# Pushing $(IMAGE_REF)"
	DIGEST_FILE=$$(mktemp)
	$(CONTAINER_ENGINE) push --digestfile="$${DIGEST_FILE}" $(IMAGE_REF)
	echo "# Pushed $(IMAGE_REF)@$$(cat $${DIGEST_FILE})"
	rm -f "$${DIGEST_FILE}"

# Run each collections/*/validate.py against packages installed in the image.
validate:
	$(call load_recipe_conf)
	@echo "# Validating collections in $(IMAGE_REF)"
	@if ! $(CONTAINER_ENGINE) image inspect "$(IMAGE_REF)" >/dev/null 2>&1; then \
		echo "Image not found locally. Run: make build RECIPE=$(RECIPE) PUSH_IMAGES=no"; \
		exit 1; \
	fi
	@shopt -s nullglob; \
	scripts=( "$(RECIPE_DIR)"/collections/*/validate.py ); \
	if [ $${#scripts[@]} -eq 0 ]; then \
		echo "No collections/*/validate.py in $(RECIPE_DIR) — nothing to validate."; \
		exit 0; \
	fi; \
	status=0; \
	for script in "$${scripts[@]}"; do \
		cid=$$(basename "$$(dirname "$$script")"); \
		echo "# Collection: $${cid}"; \
		if ! $(CONTAINER_ENGINE) run --rm --entrypoint python "$(IMAGE_REF)" \
			"/opt/app-root/src/collections/$${cid}/validate.py"; then \
			status=1; \
		fi; \
	done; \
	exit $${status}
