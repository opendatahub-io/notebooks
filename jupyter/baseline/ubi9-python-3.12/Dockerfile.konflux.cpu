############################################################################################
# Hermetic Dockerfile for jupyter/baseline/ubi9-python-3.12
#
# RPMs and Python packages are installed from Cachi2 prefetch inputs:
# - RPMs: prefetch-input/odh (see rpms.in.yaml / rpms.lock.yaml)
# - Python: --no-index --find-links /cachi2/output/deps/pip
#
# Multi-stage layout:
#   cpu-base         -> installs OS packages + tools (oc client)
#   jupyter-minimal  -> PDF export OS deps + Jupyter entrypoint
#   jupyter-baseline -> final image (JupyterLab + Elyra/Kale + Python packages)
############################################################################################

#########################
# configuration args    #
#########################
ARG BASE_IMAGE

############################################################################################
# cpu-base: Runtime base image with OS packages, tools (oc)
############################################################################################
FROM ${BASE_IMAGE} AS cpu-base

WORKDIR /opt/app-root/bin

# OS Packages needs to be installed as root
USER 0

ARG RHEL_VERSION=9.8

# [HERMETIC] Import GPG keys for prefetched RPM verification.
RUN rpm --import /cachi2/output/deps/generic/RPM-GPG-KEY-CentOS-Official || true
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

# PQC (OCP 5.0): the rhel9/python-312 base does not enable post-quantum
# crypto by default (only RHEL 10 does); set the system policy explicitly.
RUN update-crypto-policies --set DEFAULT:PQ

### BEGIN PyPI pip and uv index
ENV PIP_INDEX_URL=https://pypi.org/simple
ENV UV_INDEX_URL=https://pypi.org/simple
ENV UV_DEFAULT_INDEX=https://pypi.org/simple
RUN /bin/bash <<'EOF'
set -Eeuxo pipefail
if [ -f /opt/app-root/pip.conf ]; then
  sed -i 's|^index-url = .*|index-url = https://pypi.org/simple|' /opt/app-root/pip.conf
fi
if [ -f /opt/app-root/uv.toml ]; then
  sed -i 's|^index-url = .*|index-url = "https://pypi.org/simple"|' /opt/app-root/uv.toml
fi
EOF

### END PyPI pip and uv index

# Bust layer cache when prefetched RPM set changes
COPY prefetch-input/odh/rpms.lock.yaml /dev/null
COPY prefetch-input/rhds/rpms.lock.yaml /dev/null

# Install useful OS packages (runtime dependencies); oc from openshift-clients RPM.
# compat-openssl11 provides libcrypto.so.1.1 for openshift-clients on EL9 (check-payload FIPS scan).
RUN --mount=type=bind,source=base-images/utils,target=/utils,ro \
    /bin/bash <<'EOF'
set -Eeuxo pipefail
BASE_PKGS=(tar perl mesa-libGL skopeo compat-openssl11 openshift-clients)
dnf install -y "${BASE_PKGS[@]}"
dnf clean all
rm -rf /var/cache/yum
EOF


# ppc64le/s390x: install openblas-threads (provides libopenblasp.so.0 at runtime for numpy/scipy)
RUN --mount=type=bind,source=base-images/utils,target=/utils,ro \
    /bin/bash <<'EOF'
set -Eeuxo pipefail
if [[ $(uname -m) == "ppc64le" ]] || [[ $(uname -m) == "s390x" ]]; then
   dnf install -y openblas-threads
   dnf clean all
   rm -rf /var/cache/yum /var/cache/dnf
fi
EOF

USER 1001

####################
# python-builder   #
####################
# [SDIST] Compile the pinned Python packages from source distributions
# into /opt/app-root/src/wheels. The jupyter-baseline stage installs those wheels with
# --no-index, so the shipped Python packages never come from precompiled
# PyPI wheels.
FROM cpu-base AS python-builder

ARG BASELINE_SOURCE_CODE=jupyter/baseline/ubi9-python-3.12
ARG PYLOCK_FLAVOR

USER 0

# [SDIST] Toolchain for compiling sdists, from hermetic RPM locks.
# openblas-devel provides BLAS/LAPACK for numpy; rust and cargo for Rust
# extensions; ninja-build and cmake for parallel native builds.
RUN dnf install -y gcc-c++ openblas-devel rust cargo ninja-build cmake \
    && dnf clean all && rm -rf /var/cache/dnf /var/cache/yum

COPY ${BASELINE_SOURCE_CODE}/requirements.${PYLOCK_FLAVOR}.txt ./requirements.txt

# uv (the lock's own pinned version), as a wheel from the lock's own index
# (PyPI for ODH, AIPCC for RHOAI) - compiling it from the rust sdist takes
# ~17 min. uv drives the bootstrap below: parallel sdist builds and a
# persistent wheel cache shared by every RUN in this stage.
RUN /bin/bash <<'EOF'
set -Eeuo pipefail
UV_VERSION=$(sed -n 's/^uv==\([^ ;]*\).*/\1/p' ./requirements.txt)
INDEX_URL=$(sed -n 's/^--index-url //p' ./requirements.txt)
python3 -m pip install --no-cache-dir \
    --index-url ${INDEX_URL:-https://pypi.org/simple} \
    uv==${UV_VERSION}
EOF

# [SDIST] Build-system toolchain, compiled once from sdists and reused
# by every package below via --no-build-isolation (ninja/cmake from dnf).
# Self-referential backends (hatchling, cffi, ...) bootstrap through
# build isolation. Pinned entries resolve cross-package spec conflicts:
# flit-core<4 (several backends cap it) and maturin<2.
RUN /bin/bash <<'EOF'
set -Eeuo pipefail
PYBIN=$(command -v python3)
uv pip install --system --python $PYBIN --no-binary :all: \
    setuptools wheel \
    'setuptools-scm[toml]' setuptools-git-versioning setuptools-rust \
    'maturin>=1.14.1,<2' 'flit-core>=3.12,<4' pdm-backend \
    meson meson-python cython patchelf hatchling poetry-core \
    scikit-build-core jupyter-packaging jupyter_builder mypy pybind11 \
    puccinialin uv-build hatch-fancy-pypi-readme hatch-jupyter-builder \
    hatch-nodejs-version hatch-vcs cffi packaging pkgconfig \
    coherent-licensed colorama expandvars build
EOF

# Build-time importability for the no-isolation wheel step:
# ipykernel build hook imports its own source, which imports
# jupyter_client (and its import chain); notebook, jupyter-bokeh,
# jupyter-server-proxy, jupyterlab-git-core and odh-kale declare
# jupyterlab in build-system.requires (checked via importlib
# metadata, so --no-deps suffices). Empirically, import ipykernel
# needs exactly this closure (checked in a scratch container); the full
# jupyterlab tree is
# neither needed nor installable from sdists: its isolated build
# envs self-reference through hatch-jupyter-builder -> jupyterlab.
RUN /bin/bash <<'EOF'
set -Eeuo pipefail
JUPYTERLAB=$(sed -n 's/^jupyterlab==\([^ ;]*\).*/\1/p' ./requirements.txt)
JCLIENT=$(sed -n 's/^jupyter-client==\([^ ;]*\).*/\1/p' ./requirements.txt)
JCORE=$(sed -n 's/^jupyter-core==\([^ ;]*\).*/\1/p' ./requirements.txt)
TRAITLETS=$(sed -n 's/^traitlets==\([^ ;]*\).*/\1/p' ./requirements.txt)
PYZMQ=$(sed -n 's/^pyzmq==\([^ ;]*\).*/\1/p' ./requirements.txt)
TORNADO=$(sed -n 's/^tornado==\([^ ;]*\).*/\1/p' ./requirements.txt)
PLATFORMDIRS=$(sed -n 's/^platformdirs==\([^ ;]*\).*/\1/p' ./requirements.txt)
DATEUTIL=$(sed -n 's/^python-dateutil==\([^ ;]*\).*/\1/p' ./requirements.txt)
SIX=$(sed -n 's/^six==\([^ ;]*\).*/\1/p' ./requirements.txt)
# python-dateutil builds in isolation: its setuptools_scm<8.0 pin is unsatisfiable
# against the toolchain setuptools-scm
python3 -m pip install --no-deps --no-binary :all: \
    python-dateutil==${DATEUTIL}
python3 -m pip install --no-deps --no-build-isolation --no-binary :all: \
    jupyterlab==${JUPYTERLAB} \
    jupyter-client==${JCLIENT} jupyter-core==${JCORE} \
    traitlets==${TRAITLETS} pyzmq==${PYZMQ} tornado==${TORNADO} \
    platformdirs==${PLATFORMDIRS} six==${SIX}
EOF


# [SDIST] Compile every pinned package from its sdist (--no-binary :all:)
# in one pip invocation, against the toolchain installed above.
# (pip wheel, not uv: uv has no `uv pip wheel`.)
RUN /bin/bash <<'EOF'
set -Eeuo pipefail
export PIP_CACHE_DIR=/tmp/pip-cache
mkdir -p /opt/app-root/src/wheels
# strip --hash pins, line continuations and environment markers from
# the pip-compiled lock so every entry is a plain name==version spec
sed '/--hash/d' ./requirements.txt \
    | tr -d '\\' | sed 's/[[:space:]]*$//' \
    | grep '^[A-Za-z0-9_.-]*==' \
    | sed 's/;.*$//' > /tmp/requirements-sdist.txt
# python-dateutil pins setuptools_scm<8.0, which conflicts with the
# toolchain's newer setuptools-scm; build just that one in isolation
grep -v '^python-dateutil==' /tmp/requirements-sdist.txt > /tmp/requirements-shared.txt
python3 -m pip wheel --no-deps --no-build-isolation --no-binary :all: \
    -w /opt/app-root/src/wheels -r /tmp/requirements-shared.txt
while IFS= read -r spec; do
  python3 -m pip wheel --no-deps --no-binary :all: \
      -w /opt/app-root/src/wheels "$spec"
done < <(grep '^python-dateutil==' /tmp/requirements-sdist.txt)
EOF

####################
# jupyter-minimal  #
####################
FROM cpu-base AS jupyter-minimal

ARG JUPYTER_REUSABLE_UTILS=jupyter/utils
ARG MINIMAL_SOURCE_CODE=jupyter/minimal/ubi9-python-3.12

WORKDIR /opt/app-root/bin

COPY --chown=1001:0 ${JUPYTER_REUSABLE_UTILS} utils/

USER 0

RUN rpm --import /cachi2/output/deps/generic/RPM-GPG-KEY-CentOS-Official || true
RUN rpm --import /cachi2/output/deps/generic/RPM-GPG-KEY-EPEL-9 || true
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

# Bust layer cache when prefetched RPM set changes
COPY prefetch-input/odh/rpms.lock.yaml /dev/null
COPY prefetch-input/rhds/rpms.lock.yaml /dev/null

### BEGIN Dependencies for PDF export
RUN ./utils/install_pdf_deps.sh

### END Dependencies for PDF export

COPY ${MINIMAL_SOURCE_CODE}/start-notebook.sh ./
RUN chmod 755 ./start-notebook.sh

USER 1001

WORKDIR /opt/app-root/src

ENTRYPOINT ["start-notebook.sh"]

########################
# jupyter-baseline     #
########################
FROM jupyter-minimal AS jupyter-baseline

ARG BASELINE_SOURCE_CODE=jupyter/baseline/ubi9-python-3.12
ARG PYLOCK_FLAVOR

ARG LABEL_REGISTRY_PREFIX
ARG LABEL_COMPONENT
ARG RELEASE

LABEL name="${LABEL_REGISTRY_PREFIX}/${LABEL_COMPONENT}" \
      com.redhat.component="${LABEL_COMPONENT}" \
      io.k8s.display-name="${LABEL_COMPONENT}" \
      summary="Jupyter baseline notebook image for ODH notebooks" \
      description="Jupyter baseline notebook image with Python 3.12 based on UBI9 for ODH notebooks" \
      io.k8s.description="Jupyter baseline notebook image with Python 3.12 based on UBI9 for ODH notebooks" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      version="${RELEASE}"

WORKDIR /opt/app-root/bin

USER 0

# Bust layer cache when prefetched RPM set changes
COPY prefetch-input/odh/rpms.lock.yaml /dev/null
COPY prefetch-input/rhds/rpms.lock.yaml /dev/null

RUN --mount=type=bind,source=base-images/utils,target=/utils,ro \
    bash /utils/dnf-helper.sh install jq git-lfs libsndfile libxcrypt-compat protobuf pandoc

COPY ${BASELINE_SOURCE_CODE}/requirements.${PYLOCK_FLAVOR}.txt ./requirements.txt
COPY --chown=1001:0 ${BASELINE_SOURCE_CODE}/setup-elyra.sh ${BASELINE_SOURCE_CODE}/setup-kale.sh ${BASELINE_SOURCE_CODE}/utils ./utils/
COPY --chown=1001:0 --chmod=0755 base-images/utils/ensure-openshift-site-packages.sh /usr/local/bin/ensure-openshift-site-packages.sh

# Install uv (build tool) before the main package install.
# UV_VERSION is derived from this image's requirements.cpu.txt by
# scripts/dockerfile_fragments.py.
#
# Runs as USER 1001:0: files under /opt/app-root must stay 1001:0-owned,
# because ensure-openshift-site-packages.sh (USER 1001:0) cannot chmod
# root-owned files (EPERM).
USER 1001:0

### BEGIN UV version
ARG UV_VERSION=0.12.5

### END UV version
RUN python3 -m pip install --no-cache-dir \
    "uv==${UV_VERSION}"

# [SDIST] Install all Python packages from the wheels compiled in the
# python-builder stage. The wheel directory is mounted into this step;
# uv opens the wheels read-write and the from-mount is read-only, so
# they are served from a scratch copy removed before the layer
# commits (the wheels never become image content).
# Locally built wheels do not match the --hash pins in requirements.txt
# (those pin the official PyPI artifacts), so install from a hash-free
# requirements file.
RUN --mount=from=python-builder,source=/opt/app-root/src/wheels,target=/wheels \
    /bin/bash <<'EOF'
set -Eeuxo pipefail
umask 0002

sed '/--hash/d' ./requirements.txt | tr -d '\\' > ./requirements-nohash.txt

# The from-mount is read-only and uv opens wheels read-write:
# scratch copy in, removed before the layer commits.
mkdir -p /tmp/wheels
cp /wheels/*.whl /tmp/wheels/

echo "Installing software and packages"
UV_NO_CACHE=true UV_LINK_MODE=copy UV_PREVIEW_FEATURES=pylock uv pip install --no-index \
    --strict --no-deps --no-config --no-progress \
    --compile-bytecode --index-strategy=unsafe-best-match \
    --find-links /tmp/wheels \
    --requirements=./requirements-nohash.txt
rm -rf /tmp/wheels

# JupyterLab/Elyra/Kale install only on x86_64/aarch64 (Path B allowlist; no
# PyPI wheels for argon2-cffi-bindings and other native deps). Skip Jupyter
# post-install on ppc64le/s390x — kernel.json and labextension do not exist.
if [[ "$(uname -m)" != "s390x" && "$(uname -m)" != "ppc64le" ]]; then
    mkdir -p /opt/app-root/runtimes
    mkdir -p /opt/app-root/pipeline-runtimes
    rm -f /opt/app-root/share/jupyter/metadata/runtime-images/*.json
    sed -i -e "s/Python.*/$(python --version | cut -d '.' -f-2)\",/" \
        /opt/app-root/share/jupyter/kernels/python3/kernel.json
    # copy jupyter configuration (install -m 0664 for OpenShift gid 0 g+w)
    install -D -m 0664 /opt/app-root/bin/utils/jupyter_server_config.py \
      /opt/app-root/etc/jupyter/jupyter_server_config.py
    jupyter labextension disable "@jupyterlab/apputils-extension:announcements"
    chmod g+w /opt/app-root/etc/jupyter/labconfig
    /opt/app-root/bin/utils/addons/apply.sh
else
    echo "JupyterLab stack is not installed on $(uname -m); skipping Jupyter post-install."
fi
/usr/local/bin/ensure-openshift-site-packages.sh
EOF

ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig/

USER 1001

WORKDIR /opt/app-root/src